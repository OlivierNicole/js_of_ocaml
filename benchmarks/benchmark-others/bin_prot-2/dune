(library
 (name bin_prot_bench)
 (modules bench_numbers bench_lists bin_prot_bench)
 (libraries bin_prot)
 (preprocess
  (pps ppx_bench)))

(executable
  (name bench)
  (modules bench)
  (modes js wasm)
  (libraries bin_prot_bench core_bench.runner_js)
  (js_of_ocaml
    (enabled_if true))
  (wasm_of_ocaml
    (flags --opt 2 --enable use-js-string))
  (link_flags (:standard -linkall))
)
