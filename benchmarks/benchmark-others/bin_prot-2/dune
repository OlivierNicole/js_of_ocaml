  (name bench)
  (modules bench)
  (modes js wasm)
  (libraries bin_prot_bench core_bench.js)
  (js_of_ocaml
    (enabled_if true))
  (wasm_of_ocaml
    (flags --opt 2 --enable use-js-string))
  (link_flags (:standard -linkall))
)
