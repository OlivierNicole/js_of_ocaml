(library
 (name bin_prot_bench)
 (modules bench_numbers bench_lists bin_prot_bench)
 (libraries bin_prot core core_unix ppx_bench.runtime-lib ppx_module_timer.runtime threads)
 (preprocess
  (pps ppx_jane)))

